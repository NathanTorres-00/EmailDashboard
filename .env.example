# Mailchimp API keys, one per account. The server prefix (e.g. us21) is read
# from the part of the key after the dash. Copy this file to .env for local
# development with `vercel dev`; in production set these in Vercel's
# Environment Variables instead. Never commit the real .env file.

# Account 1 — Solid Lives
MAILCHIMP_API_KEY=your-api-key-us21

# Account 2 — The Rock Network
MAILCHIMP_API_KEY_2=your-api-key-us21

# Account 3 — Jesus Disciple
MAILCHIMP_API_KEY_3=your-api-key-us21
