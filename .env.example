# Mailchimp API key for The Rock Anaheim account. The server prefix (e.g. us21)
# is read from the part of the key after the dash. Copy this file to .env for
# local development with `vercel dev`; in production set it in Vercel's
# Environment Variables instead. Never commit the real .env file.
MAILCHIMP_API_KEY=your-api-key-us21
